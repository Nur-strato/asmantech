# Скопируйте в .env.local для локальной разработки. Реальные значения — только в Vercel → Settings → Environment Variables.

# Ключ Claude API (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Любая случайная строка (A-Z, a-z, 0-9, _ и -, до 256 символов). Telegram присылает её в заголовке каждого вебхука.
TELEGRAM_WEBHOOK_SECRET=

# Необязательно: ID чата/группы менеджеров, куда бот дублирует каждую заявку
TELEGRAM_ADMIN_CHAT_ID=

# Необязательно: другая модель Claude (по умолчанию claude-opus-5-5)
CHATBOT_MODEL=

# Необязательно: полный URL роута заявок, если он не на том же домене (по умолчанию <домен вебхука>/api/leads)
LEADS_API_URL=
